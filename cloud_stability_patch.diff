--- /dev/null
+++ b/infra/cloud_executor.py
@@ -0,0 +1,20 @@
+from infra.http_client import send_post
+
+def execute_cloud_trade(data):
+    try:
+        res = send_post("/trade", data)
+        res.raise_for_status()
+        return res.json()
+    except Exception:
+        res = send_post("/signal", data)
+        res.raise_for_status()
+        return res.json()
+
