diff --git a/infra/execution_router.py b/infra/execution_router.py
new file mode 100644
index 0000000..6666666
--- /dev/null
+++ b/infra/execution_router.py
@@ -0,0 +1,25 @@
+from config import Config
+from infra.cloud_executor import execute_cloud_trade
+from infra.health import is_cloud_alive
+
+def route_execution(data, local_execute_fn=None):
+    if Config.EXECUTION_MODE == "cloud":
+        return execute_cloud_trade(data)
+
+    if Config.EXECUTION_MODE == "local":
+        return local_execute_fn(data)
+
+    if is_cloud_alive():
+        return execute_cloud_trade(data)
+
+    if Config.LOCAL_FALLBACK_ENABLED and local_execute_fn:
+        return local_execute_fn(data)
+
+    raise Exception("No execution path available")
+
